{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "config/**/*.ts",
    "src/app-server.ts",
    "src/app-routes.ts",
    "server.ts",
    "vite.config.ts",
    "test/helpers/**/*.ts",
    "src/**/*.ts",
    "migration/**/*.ts",
    "web/print.ts"
  ],
  "exclude": ["node_modules", "dist", "backup-*"]
}
