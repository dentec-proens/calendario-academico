{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/app",
  "rewrites": [
    {
      "source": "/",
      "destination": "/portal.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/editor",
      "destination": "/index.html"
    },
    {
      "source": "/logs",
      "destination": "/logs.html"
    },
    {
      "source": "/recuperar-senha",
      "destination": "/recover.html"
    },
    {
      "source": "/ativar",
      "destination": "/activate.html"
    },
    {
      "source": "/ativar-conta",
      "destination": "/activate.html"
    }
  ]
}
