{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "node",
  "installCommand": "npx --yes pnpm@12.15.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.15.0 run build",
  "functions": {
    "server.mjs": {
      "maxDuration": 60,
      "includeFiles": "{web/**,src/**,dist/portal/**,node_modules/@sparticuz/chromium/bin/**,node_modules/pdfjs-dist/legacy/build/**}"
    }
  }
}
