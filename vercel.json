{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/app",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/logs",
      "destination": "/index.html"
    },
    {
      "source": "/recuperar-senha",
      "destination": "/index.html"
    },
    {
      "source": "/ativar-conta",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios",
      "destination": "/index.html"
    },
    {
      "source": "/documentos",
      "destination": "/index.html"
    },
    {
      "source": "/eventos-institucionais",
      "destination": "/index.html"
    },
    {
      "source": "/revisoes",
      "destination": "/index.html"
    },
    {
      "source": "/campi",
      "destination": "/index.html"
    },
    {
      "source": "/contas",
      "destination": "/index.html"
    },
    {
      "source": "/usuarios-online",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/novo",
      "destination": "/index.html"
    },
    {
      "source": "/documentos/novo",
      "destination": "/index.html"
    },
    {
      "source": "/eventos-institucionais/novo",
      "destination": "/index.html"
    },
    {
      "source": "/campi/novo",
      "destination": "/index.html"
    },
    {
      "source": "/contas/nova",
      "destination": "/index.html"
    },
    {
      "source": "/revisoes/:calendarId",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/editar",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/periodos",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/avaliacoes",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/dias",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/ferias",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/eventos",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/historico",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/pendencias",
      "destination": "/index.html"
    },
    {
      "source": "/calendarios/:calendarId/visualizar",
      "destination": "/index.html"
    },
    {
      "source": "/eventos-institucionais/:eventId/editar",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://*.convex.cloud wss://*.convex.cloud https://*.convex.site; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
