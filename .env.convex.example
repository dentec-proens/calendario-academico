# Copie somente neste worktree para .env.convex.local (arquivo ignorado pelo Git).
# Os comandos dev:convex/start:convex carregam este arquivo explicitamente.
# O modo Convex não lê .env e não usa PostgreSQL nem Supabase.
DENTEC_BACKEND=convex
PORT=4183
DENTEC_PUBLIC_URL=http://127.0.0.1:4183

# URL do deployment de desenvolvimento criado no team indicado.
CONVEX_URL=https://SEU-DEPLOYMENT.convex.cloud
# Segredo aleatório de pelo menos 32 caracteres, somente no servidor Node e no Convex.
# Configure o mesmo valor nas variáveis do deployment de teste no dashboard do Convex.
DENTEC_CONVEX_BRIDGE_SECRET=

# O CLI do Convex grava CONVEX_DEPLOYMENT em .env.local ao configurar o projeto.
# Não use deployments de produção nem importe dados institucionais neste experimento.

# Desenvolvimento: opcionais; código de instalação é gerado no terminal se omitido.
# Se informar e-mail, use o institucional que criará a primeira conta ADMIN.
DENTEC_SETUP_EMAIL=
DENTEC_SETUP_CODE=

# Login Google opcional. Redirect URI local:
# http://127.0.0.1:4183/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exportação local de PDF: caminho do Google Chrome/Chromium, se necessário.
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
DENTEC_PDF_BROWSER=

# Recuperação por e-mail opcional; chaves somente no servidor.
RESEND_API_KEY=
DENTEC_MAIL_FROM=
