# Configure only on the server. Never put the client secret in web/ or send it in chat.
# Without both Google values, existing local login stays available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local test; the Google OAuth client must register this exact redirect URI:
# http://127.0.0.1:4173/api/google/callback
DENTEC_PUBLIC_URL=http://127.0.0.1:4173

# Vercel only: integration supplies POSTGRES_URL and Supabase server keys.
# Configure these in the Vercel Production environment, never in Git.
DENTEC_SETUP_EMAIL=
DENTEC_SETUP_CODE=
