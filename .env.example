# Cada pessoa executa pnpm dev:setup; a CLI grava seu próprio dev em .env.local.
# Projeto institucional: diretoria-de-ensino-tecnico-proens/calendario-academico.
# Não copie o deployment de outro desenvolvedor nem as variáveis de produção.
CONVEX_DEPLOYMENT=dev:seu-deployment
VITE_CONVEX_URL=https://seu-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://seu-deployment.convex.site
PORT=4183

# JWT_PRIVATE_KEY, JWKS, SITE_URL e código de instalação pertencem ao Convex.
# Nenhum segredo deve receber prefixo VITE_ ou entrar no Git.

# VERCEL_TOKEN e DENTEC_RELEASE_BACKUP_DIR da release não ficam neste arquivo:
# pnpm deploy:production lê .vercel/release.env e explica como criá-lo.
