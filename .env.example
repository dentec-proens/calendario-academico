# O Convex CLI cria .env.local ao executar pnpm exec convex dev.
# Somente variáveis VITE_* públicas entram no bundle do navegador.
CONVEX_DEPLOYMENT=dev:seu-deployment
VITE_CONVEX_URL=https://seu-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://seu-deployment.convex.site
PORT=4183

# Segredos de autenticação e provedores pertencem ao ambiente Convex,
# configurados com pnpm exec convex env set; nunca use prefixo VITE_ neles.
