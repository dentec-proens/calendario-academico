# PostgreSQL é obrigatório em desenvolvimento e produção.
# Credencial de aplicação restrita (somente servidor); DATABASE_URL é um alias.
# Supabase: Session pooler 5432 para backend persistente IPv4;
# Transaction pooler 6543 para Vercel/serverless. Não cole a senha real no Git.
POSTGRES_URL=postgresql://dentec_app:SENHA@localhost:5432/dentec
# A credencial de migração tem DDL e é usada somente por pnpm run db:migrate.
# Pode ficar em outro arquivo ignorado ou no ambiente do comando de migração.
DENTEC_MIGRATION_DATABASE_URL=
# Nome de uma role restrita já provisionada, para conceder acesso durante a migração.
# Deve corresponder ao usuário de POSTGRES_URL (no projeto de testes: dentec_test_app).
DENTEC_DATABASE_ROLE=dentec_app

DENTEC_PUBLIC_URL=http://127.0.0.1:4173

# PDFs: opcionais em desenvolvimento; obrigatórios em produção.
# Com ambas vazias, o desenvolvimento guarda PDFs no PostgreSQL.
# Se informar uma delas, a outra também é obrigatória.
# Chave secreta exclusivamente no servidor, nunca em web/ ou VITE_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Produção: e-mail institucional inicial e segredo com pelo menos 32 caracteres.
# Desenvolvimento: se omitidos, o código inicial é gerado no terminal.
DENTEC_SETUP_EMAIL=
DENTEC_SETUP_CODE=

# Login Google opcional fora da Vercel; sem o par, login por senha continua ativo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI para o cliente Google local:
# http://127.0.0.1:4173/api/google/callback

# Recuperação de senha: remetente verificado e chave de envio (somente servidor).
RESEND_API_KEY=
DENTEC_MAIL_FROM=
