{
  "name": "dentec-calendarios",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:supabase": "node --env-file=.env.supabase-test --test test/postgres.test.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:import": "node scripts/database.mjs import",
    "db:export": "node scripts/database.mjs export",
    "dev:convex": "node --env-file=.env.convex.local scripts/dev.mjs",
    "start:convex": "node --env-file=.env.convex.local server.mjs",
    "convex:push": "convex dev --once --typecheck enable",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test:convex": "DENTEC_TEST_BACKEND=convex node --test --test-concurrency=1 test/*.test.mjs",
    "build:convex:native": "node scripts/build-native.mjs",
    "start:convex:native": "node --env-file=.env.convex.local server-native.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "0.0.96",
    "@noble/hashes": "2.0.1",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "2.116.0",
    "convex": "1.47.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "puppeteer-core": "25.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "convex-test": "0.0.64",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
