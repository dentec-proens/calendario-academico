{
  "name": "dentec-calendarios",
  "version": "0.12.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "start": "tsx server.ts",
    "preview": "tsx server.ts",
    "convex:dev": "tsx scripts/convex-dev.ts",
    "convex:codegen": "convex codegen",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:convex && pnpm run typecheck:tools && pnpm run typecheck:tests",
    "typecheck:app": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "lint:types": "oxlint --type-aware --deny-warnings convex web scripts config src/app-server.ts src/app-routes.ts server.ts vite.config.ts test/helpers \"test/**/*.ts\" src/calendar.ts src/history-dates.ts src/domain-types.ts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run typecheck && pnpm test && pnpm run build",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "env:doctor": "tsx scripts/doctor.ts",
    "deploy:production": "tsx scripts/deploy-production.ts",
    "test:unit": "vitest run --exclude test/native-portal-browser.test.ts",
    "test:watch": "vitest",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:browser": "vitest run test/native-portal-browser.test.ts",
    "migrate:data": "tsx scripts/migrate-data.ts"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=12.15.0 <13"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "0.0.96",
    "@noble/hashes": "2.0.1",
    "@sparticuz/chromium": "153.0.0",
    "convex": "1.47.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.3.289",
    "puppeteer-core": "25.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.64",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
