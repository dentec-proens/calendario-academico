{
  "name": "dentec-calendarios",
  "version": "0.12.0-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "start": "tsx server.ts",
    "preview": "tsx server.ts",
    "convex:dev": "tsx scripts/convex-dev.ts",
    "convex:codegen": "convex codegen",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:convex && pnpm run typecheck:tools && pnpm run typecheck:tests",
    "typecheck:app": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "lint:types": "oxlint --type-aware --deny-warnings convex web scripts config src migration server.ts vite.config.ts vitest.config.ts playwright.config.ts playwright.e2e.config.ts test",
    "format": "prettier --write . \"!**/*.{md,mdx,markdown}\"",
    "format:check": "prettier --check . \"!**/*.{md,mdx,markdown}\"",
    "format:docs": "prettier --write \"**/*.{md,mdx,markdown}\"",
    "format:docs:check": "prettier --check \"**/*.{md,mdx,markdown}\"",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:functional": "playwright test --project=chromium",
    "test:browser:install": "playwright install chromium",
    "test:browser:ui": "playwright test --ui",
    "test:browser:trace": "playwright test --trace=retain-on-failure",
    "test:visual": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:visual:update": "pnpm run test:visual --update-snapshots",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "check": "tsx scripts/check.ts",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "env:doctor": "tsx scripts/doctor.ts",
    "deploy:production": "tsx scripts/deploy-production.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "migrate:data": "tsx scripts/migrate-data.ts",
    "agents:check": "node scripts/check-agent-skills.ts",
    "e2e:setup": "tsx scripts/setup-e2e.ts"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=12.15.0 <13"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "1.9.0",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/migrations": "0.3.7",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rate-limiter": "0.4.2",
    "@noble/hashes": "2.0.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "convex": "1.48.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tar-fs": "3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tanstack/intent": "0.5.6",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tar-fs": "2.0.4",
    "convex-test": "0.0.64",
    "fflate": "0.8.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "intent": {
    "skills": [
      "@tanstack/react-router",
      "@tanstack/router-core",
      "@tanstack/devtools"
    ]
  }
}
