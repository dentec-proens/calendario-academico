{
  "name": "dentec-calendarios",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:supabase": "node --env-file=.env.supabase-test --test test/postgres.test.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:import": "node scripts/database.mjs import",
    "db:export": "node scripts/database.mjs export"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "puppeteer-core": "25.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  }
}
